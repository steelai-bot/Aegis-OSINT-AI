# Aegis OSINT AI - Environment Configuration
# Copy this file to .env and fill in your API keys

# ── AI Provider API Keys ──────────────────────────────────────────────────────
# OpenRouter - Recommended for free models (https://openrouter.ai)
OPENROUTER_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# Anthropic (https://www.anthropic.com)
ANTHROPIC_API_KEY=

# Google Gemini (https://ai.google.dev)
GEMINI_API_KEY=

# Nvidia (https://developer.nvidia.com)
NVIDIA_API_KEY=

# ── OSINT Configuration ──────────────────────────────────────────────────────
# Australian Business Register GUID (optional, for ABR API access)
ABR_GUID=

# ── Application Configuration ──────────────────────────────────────────────────
# Server settings
HOST=127.0.0.1
PORT=8000

# Database (SQLite)
DATABASE=data/aegis.db

# ── Optional: External API Keys ───────────────────────────────────────────────
# Shodan (https://shodan.io)
SHODAN_API_KEY=

# VirusTotal (https://virustotal.com)
VIRUSTOTAL_API_KEY=

# SecurityTrails (https://securitytrails.com)
SECURITYTRAILS_API_KEY=

# Have I Been Pwned (https://haveibeenpwned.com)
HIBP_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────────────
# - OpenRouter offers free models - recommended for testing
# - API keys are stored in .env and never committed to git
# - Restart the application after changing API keys